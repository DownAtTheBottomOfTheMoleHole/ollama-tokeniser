{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":enableVulnerabilityAlerts",
    "helpers:pinGitHubActionDigests"
  ],
  "dependencyDashboard": true,
  "prConcurrentLimit": 2,
  "prHourlyLimit": 1,
  "vulnerabilityAlerts": {
    "enabled": true,
    "prConcurrentLimit": 1,
    "labels": ["security", "renovate"],
    "automerge": false
  }
}
